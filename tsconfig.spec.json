{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "../out-tsc/spec",
    "types": [
      "jest",
      "node"
    ]
  },
  "files": [
  ],
  "exclude": [
    "node_modules/**",
    "dist/**"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "projects/**/*.spec.ts",
    "projects/**/*.d.ts",
    "src/global.d.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
